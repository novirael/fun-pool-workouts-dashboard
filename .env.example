# Copy to .env.local for local development.

# Shared family password. Letter case and surrounding spaces are ignored when typing it.
APP_PASSWORD=change-me

# Random secret that signs device tokens, e.g. `openssl rand -base64 32`.
# Changing APP_PASSWORD or AUTH_SECRET signs every device out.
AUTH_SECRET=

# Neon Postgres, set automatically by the Vercel Neon integration (Production).
# Leave unset locally: `npm run dev` then uses an embedded PGlite database in .data/.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
