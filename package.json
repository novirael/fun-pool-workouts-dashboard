{
  "name": "fun-pool-workouts-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "A playful family swim log for kids: log pool lengths, climb mountains, cross lakes, earn badges and travel around Poland together.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/novirael/fun-pool-workouts-dashboard.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@tanstack/react-query": "5.104.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
